# RapidAPI key used by the Translator page (src/lib/translateApi.js).
# Get one at rapidapi.com — subscribe to a translation API (free tier is fine)
# and copy the key from the "X-RapidAPI-Key" header in its code snippet.
VITE_RAPIDAPI_KEY=

# Defaults target the "Text Translator2" API on RapidAPI. If you subscribe to
# a different translation API instead, override its host/endpoint here —
# no code changes needed as long as it accepts { source_language, target_language, text }.
# VITE_RAPIDAPI_HOST=text-translator2.p.rapidapi.com
# VITE_RAPIDAPI_URL=https://text-translator2.p.rapidapi.com/translate
